# ─── LLM / API Keys ──────────────────────────────────────────────────────────
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the model (default is gemini-2.5-flash; check provider pricing)
GEMINI_MODEL=gemini-2.5-flash

# Optional news/search API (leave empty to skip news retrieval)
# Recommended free option: https://newsapi.org (free 100 req/day)
NEWS_API_KEY=

# ─── SEC EDGAR ───────────────────────────────────────────────────────────────
# No API key needed, but SEC requires a descriptive User-Agent header.
# Format: "YourName/1.0 contact@example.com"
SEC_USER_AGENT=YourName/1.0 contact@example.com

# ─── App Config ──────────────────────────────────────────────────────────────
# Where to store ChromaDB vector data (relative path)
CHROMA_PERSIST_DIR=./chroma_db

# Where to store JSONL audit logs and SQLite run snapshots
AUDIT_LOG_DIR=./audit_logs

# Maximum total verifier passes, including the first (1-5; default 2)
VERIFIER_MAX_RETRIES=2

# API server config
API_HOST=127.0.0.1
API_PORT=8000

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# SEC EDGAR fair-access: min seconds between requests (default 0.1)
EDGAR_REQUEST_DELAY=0.1

# Local verifier: rules (no weights), torch, or onnx
VERIFICATION_BACKEND=rules
# Maximum remote claim judgments across ALL rewrite iterations
VERIFICATION_REMOTE_BUDGET=24

# Local document search avoids cloud embedding quota. Optional: gemini
RETRIEVAL_BACKEND=bm25

# fast: local planning/arithmetic summary; deep: extra Gemini planning/analysis
RESEARCH_MODE=fast
